# ---------- Marketing / analytics (Phase 1) ----------
VITE_GA_ID=G-XXXXXXXXXX
VITE_EMAILJS_SERVICE_ID=service_id
VITE_EMAILJS_TEMPLATE_ID=template_id
VITE_EMAILJS_PUBLIC_KEY=public_key

# ---------- Backend (Phase 3) ----------
# When these two are unset, the site falls back to WhatsApp ordering as before.
# When they are set, the cart submits real orders through the place-order Edge Function.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------- Payments — client (Phase 3) ----------
# Hint to the client about which adapter to use. Server has final say.
VITE_PAYMENT_PROVIDER=cardcom
# Master switch: set to 'true' once the backend secrets below are configured
# and you've tested a real charge. Until then, place-order succeeds but the
# customer sees the WhatsApp confirmation flow rather than a PSP redirect.
VITE_PAYMENTS_ENABLED=false

# =====================================================================
# Below this line: SERVER SECRETS — set with `supabase secrets set ...`,
# never commit real values, never expose via VITE_ prefix.
# =====================================================================

# ---------- Payments — provider routing ----------
PAYMENT_PROVIDER=cardcom
PAYMENT_SUCCESS_URL_BASE=https://marzipanbakery.com/order/payment/result
PAYMENT_FAILURE_URL_BASE=https://marzipanbakery.com/order/payment/result
# Optional override (defaults to <SUPABASE_URL>/functions/v1/payment-webhook):
PAYMENT_WEBHOOK_URL_BASE=

# ---------- Cardcom (default provider) ----------
CARDCOM_TERMINAL_NUMBER=
CARDCOM_USERNAME=
CARDCOM_API_PASSWORD=
CARDCOM_BASE_URL=https://secure.cardcom.solutions

# ---------- Tranzila (alternative) ----------
TRANZILA_TERMINAL=
TRANZILA_PASSWORD=
TRANZILA_HMAC_SECRET=
TRANZILA_BASE_URL=https://direct.tranzila.com

# ---------- PayPlus (alternative) ----------
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_HMAC_SECRET=
PAYPLUS_BASE_URL=https://restapi.payplus.co.il

# ---------- Notifications — SMS ----------
# Provider: 'inforu' (default) | 'twilio' | 'console' (dev/no-op)
SMS_PROVIDER=inforu
INFORU_USER=
INFORU_API_KEY=
INFORU_SENDER=Marzipan
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Notifications — WhatsApp ----------
# Provider: 'meta_cloud' | 'console' (dev/no-op)
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---------- Cron ----------
# Shared secret protecting send-notifications + process-campaigns from
# unauthenticated triggers. The Supabase scheduled function passes this in
# the x-cron-secret header.
CRON_SHARED_SECRET=
