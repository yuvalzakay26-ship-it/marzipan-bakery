# ---------- Marketing / analytics (Phase 1) ----------

VITE_GA_ID=G-XXXXXXXXXX
VITE_EMAILJS_SERVICE_ID=service_id
VITE_EMAILJS_TEMPLATE_ID=template_id
VITE_EMAILJS_PUBLIC_KEY=public_key

# ---------- Observability — Sentry ----------

# Public DSN (safe to embed in client bundle). Production-only: when this
# is unset the SDK is a no-op, so dev/preview builds never report.
VITE_SENTRY_DSN=

# Release identifier used to tag every event. On Vercel, set this to
# $VERCEL_GIT_COMMIT_SHA so crashes can be traced back to a deploy.
VITE_APP_VERSION=

# Environment label (production | preview | staging). Defaults to
# import.meta.env.MODE if unset — only override when you need to split
# events across environments inside Sentry.
VITE_SENTRY_ENVIRONMENT=production

# Build-time secrets — used by @sentry/vite-plugin to upload source maps
# and tag the release. NEVER prefix these with VITE_ — they must not
# reach the client bundle.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---------- Backend (Phase 3) ----------

# When these two are unset, the site falls back to WhatsApp ordering as before.

# When they are set, the cart submits real orders through the place-order Edge Function.

VITE_SUPABASE_URL=https://itlrgtzdoewrtrwmtra.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_cI4vqddvNevpwVWLGVz_GA_sGGL2aAg


# ---------- Payments — client (Phase 3) ----------

# Hint to the client about which adapter to use. Server has final say.

VITE_PAYMENT_PROVIDER=cardcom

# Master switch: keep false for now (we are not using payments yet)

VITE_PAYMENTS_ENABLED=false

